    "run.compress": {"comment":"Action bar button; compresses eligible files.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compress"}}}},
    "run.decompress": {"comment":"Action bar button; restores compressed files to full disk size.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Decompress"}}}},
    "run.use_administrator": {"comment":"Action bar toggle; enables protected application or Homebrew file operations.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use administrator privileges"}}}},
    "run.administrator_help": {"comment":"Administrator toggle tooltip; explains protected file access and who authenticates.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Authorize compression or decompression of protected Homebrew and application files. macOS handles authentication."}}}},
    "run.stopping": {"comment":"Disabled stop button while the active compression batch finishes.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Stopping…"}}}},
    "run.stopping_help": {"comment":"Run progress after Stop; active work finishes safely before stopping.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for the active batch to finish safely. No further batches will start."}}}},
    "run.hide_details": {"comment":"Run outcome button; collapses the file failure list.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hide details"}}}},
    "run.show_details": {"comment":"Run outcome button; expands the file failure list.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show details"}}}},
    "run.finished_safely": {"comment":"Cancelled run outcome suffix; reassures that completed files remain safe.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"files already finished are safely compressed"}}}},
    "run.compress_eligible": {"comment":"Compress button tooltip; number of eligible files.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Compress %lld eligible file"}},"other":{"stringUnit":{"state":"translated","value":"Compress %lld eligible files"}}}}}}},
    "run.tool_unavailable": {"comment":"Disabled compress tooltip; placeholder is compressor name.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ isn't available"}}}},
    "run.progress": {"comment":"Run progress; operation verb, processed file count, and formatted total count.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%1$@ — %2$lld file of %3$@"}},"other":{"stringUnit":{"state":"translated","value":"%1$@ — %2$lld files of %3$@"}}}}}}},
    "run.current_batch": {"comment":"Run progress detail; placeholder is first file path in the active batch.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Current batch starts with: %@"}}}},
    "run.processing_failures": {"comment":"Run progress warning; failures whose details appear after completion.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file couldn't be processed — details when this finishes"}},"other":{"stringUnit":{"state":"translated","value":"%lld files couldn't be processed — details when this finishes"}}}}}}},
    "run.stopped": {"comment":"Cancelled run headline; count of successfully finished files.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Stopped after %lld file"}},"other":{"stringUnit":{"state":"translated","value":"Stopped after %lld files"}}}}}}},
    "run.decompressed": {"comment":"Decompression outcome headline; count restored to full disk size.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Decompressed %lld file"}},"other":{"stringUnit":{"state":"translated","value":"Decompressed %lld files"}}}}}}},
    "run.compressed": {"comment":"Compression outcome detail; count successfully compressed.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file compressed"}},"other":{"stringUnit":{"state":"translated","value":"%lld files compressed"}}}}}}},
    "run.had_problems": {"comment":"Run outcome detail; number of real failures needing attention.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file had problems"}},"other":{"stringUnit":{"state":"translated","value":"%lld files had problems"}}}}}}},
    "run.left_alone": {"comment":"Run outcome detail; count the compressor declined without changing.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld left alone"}},"other":{"stringUnit":{"state":"translated","value":"%lld left alone"}}}}}}},
    "run.reclaimed": {"comment":"Compression outcome headline; formatted disk space recovered.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reclaimed %@"}}}},
    "run.returned": {"comment":"Decompression outcome detail; formatted additional disk space now occupied.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ returned to disk"}}}},
    "run.duration": {"comment":"Run duration; localized decimal seconds, with abbreviated seconds suffix.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@s"}}}},
    "result.eligible": {"comment":"Summary statistic; files allowed to be compressed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Eligible"}}}},
    "result.already_compressed": {"comment":"Summary statistic; files already using transparent compression.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Already compressed"}}}},
    "result.excluded": {"comment":"Summary statistic; files omitted by safety rules.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Excluded"}}}},
    "result.for_safety": {"comment":"Excluded statistic detail; explains why files are omitted.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"for safety"}}}},
    "result.on_disk": {"comment":"Statistic and file table column; actual allocated storage.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"On disk"}}}},
    "result.nothing_to_compress": {"comment":"Summary headline when no eligible uncompressed files remain.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing left to compress here"}}}},
    "result.coverage_label": {"comment":"Accessibility label for the bar comparing compressed, eligible and excluded files.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compression coverage"}}}},
    "result.name": {"comment":"File table column and sort option; file name.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Name"}}}},
    "result.size": {"comment":"File table column; logical uncompressed byte size.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Size"}}}},
    "result.state": {"comment":"File table column; compression or safety exclusion state.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"State"}}}},
    "result.compressed": {"comment":"File state fallback when compression type is unknown.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compressed"}}}},
    "result.not_compressed": {"comment":"File state for eligible files not yet compressed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Not compressed"}}}},
    "result.show_excluded": {"comment":"Status bar toggle; includes files excluded by safety rules in the table.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Show excluded"}}}},
    "result.sort": {"comment":"Status bar picker for ordering the file table.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sort"}}}},
    "result.hard_link_help": {"comment":"Duplicate hard link count tooltip; explains storage is not double-counted.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"These paths share storage with another file, so their bytes are counted only once."}}}},
    "result.sort_largest": {"comment":"File sort option ordering by descending logical size.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Largest first"}}}},
    "result.sort_state": {"comment":"File sort option grouping by compressed state.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compression state"}}}},
    "result.files": {"comment":"Summary statistic value; file count in the category named above it.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file"}},"other":{"stringUnit":{"state":"translated","value":"%lld files"}}}}}}},
    "result.could_compress": {"comment":"Summary headline; eligible count, without promising estimated savings.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file could be compressed"}},"other":{"stringUnit":{"state":"translated","value":"%lld files could be compressed"}}}}}}},
    "result.hard_links": {"comment":"Status bar note; duplicate paths sharing storage were counted once.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld hard link counted once"}},"other":{"stringUnit":{"state":"translated","value":"%lld hard links counted once"}}}}}}},
    "result.truncated": {"comment":"Status bar warning; table is truncated to this count but totals include all files.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Showing first %lld files — totals cover everything"}},"other":{"stringUnit":{"state":"translated","value":"Showing first %lld files — totals cover everything"}}}}}}},
    "result.reclaimed": {"comment":"Already compressed detail; formatted space already recovered.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ reclaimed"}}}},
    "result.logical_size": {"comment":"On disk detail; formatted full uncompressed size for comparison.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"of %@ logical"}}}},
    "result.eligible_data": {"comment":"Summary subheading; formatted logical size of eligible files.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of eligible data"}}}},
    "result.folder_compressed": {"comment":"Summary subheading; formatted percentage of files already compressed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of this folder is already compressed"}}}},
    "result.coverage_value": {"comment":"Coverage accessibility value; formatted percentage then localized eligible and excluded file counts.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ compressed, %@ eligible, %@ excluded for safety"}}}},
    "result.scanned_in": {"comment":"Status bar; placeholder is a localized duration in seconds.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scanned in %@"}}}},
