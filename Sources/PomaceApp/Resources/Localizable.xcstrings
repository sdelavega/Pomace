    "content.compressor_unavailable": {
      "comment": "Results banner; inspection works and Advanced settings can repair compressor selection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressor is unavailable. You can still scan; choose a compressor in Settings → Advanced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩工具不可用。你仍可扫描文件；请在“设置”→“高级”中选择压缩工具。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El compresor no está disponible. Puedes seguir analizando archivos; selecciona un compresor en Ajustes → Avanzado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮ツールを使用できません。スキャンは可能です。「設定」→「詳細」で圧縮ツールを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 도구를 사용할 수 없습니다. 스캔은 계속할 수 있습니다. 설정 → 고급에서 압축 도구를 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kompressor ist nicht verfügbar. Scans sind weiterhin möglich. Wählen Sie einen Kompressor unter Einstellungen → Erweitert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compresseur est indisponible. Vous pouvez toujours analyser les fichiers. Choisissez un compresseur dans Réglages → Avancé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compressor está indisponível. Você ainda pode analisar arquivos; escolha um compressor em Ajustes → Avançado."
          }
        }
      }
    },
