    "core.planWarning.compressorUnsupported": {
      "comment": "Requested and fallback compressor names",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of applesauce doesn't support %@; using %@ instead."
          }
        }
      }
    },
    "core.planWarning.zlibSlowerReads": {
      "comment": "Maximum savings tradeoff",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB reclaims marginally more space than the default, but every later read of these files is slower. Measured on a mixed corpus the difference in size was under one percent."
          }
        }
      }
    },
    "core.runtimeConstraint.lowPowerMode": {
      "comment": "Constraint fragment",
