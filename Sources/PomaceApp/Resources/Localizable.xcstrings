            "state": "translated",
            "value": "Mantido sem alterações. O arquivo em si não foi modificado."
          }
        }
      }
    },
    "core.skipRemedy.unreadable": {
      "comment": "Permission remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For protected Homebrew or application files, enable Use administrator privileges and retry. macOS privacy controls may still require Full Disk Access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于受保护的 Homebrew 或应用程序文件，请开启“使用管理员权限”后重试。macOS 隐私控制可能仍要求“完全磁盘访问权限”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para los archivos protegidos de Homebrew o de aplicaciones, activa «Usar privilegios de administrador» y vuelve a intentarlo. Los controles de privacidad de macOS pueden seguir requiriendo Acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたHomebrewまたはアプリケーションのファイルには、「管理者権限を使用」を有効にしてやり直してください。macOSのプライバシー設定で、フルディスクアクセスも必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 Homebrew 또는 응용 프로그램 파일의 경우 ‘관리자 권한 사용’을 켜고 다시 시도하세요. macOS 개인정보 보호 설정에서 전체 디스크 접근 권한이 추가로 필요할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie für geschützte Homebrew- oder Programmdateien „Administratorrechte verwenden“ und versuchen Sie es erneut. Die macOS-Datenschutzeinstellungen können weiterhin Festplattenvollzugriff erfordern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les fichiers protégés de Homebrew ou des applications, activez « Utiliser les privilèges administrateur » et réessayez. Les réglages de confidentialité de macOS peuvent toujours exiger l’Accès complet au disque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para arquivos protegidos do Homebrew ou de aplicativos, ative “Usar Privilégios de Administrador” e tente novamente. Os controles de privacidade do macOS ainda podem exigir Acesso Total ao Disco."
          }
        }
      }
    },
    "core.skipRemedy.unwritable": {
      "comment": "Write permission remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For protected Homebrew or application files, enable Use administrator privileges and retry. Read-only volumes cannot be modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于受保护的 Homebrew 或应用程序文件，请开启“使用管理员权限”后重试。只读宗卷无法修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para los archivos protegidos de Homebrew o de aplicaciones, activa «Usar privilegios de administrador» y vuelve a intentarlo. Los volúmenes de solo lectura no se pueden modificar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたHomebrewまたはアプリケーションのファイルには、「管理者権限を使用」を有効にしてやり直してください。読み出し専用ボリュームは変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 Homebrew 또는 응용 프로그램 파일의 경우 ‘관리자 권한 사용’을 켜고 다시 시도하세요. 읽기 전용 볼륨은 수정할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie für geschützte Homebrew- oder Programmdateien „Administratorrechte verwenden“ und versuchen Sie es erneut. Schreibgeschützte Volumes können nicht geändert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les fichiers protégés de Homebrew ou des applications, activez « Utiliser les privilèges administrateur » et réessayez. Les volumes en lecture seule ne peuvent pas être modifiés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para arquivos protegidos do Homebrew ou de aplicativos, ative “Usar Privilégios de Administrador” e tente novamente. Volumes somente leitura não podem ser modificados."
          }
        }
      }
    },
