    "core.administratorAccess.prompt": {
      "comment": "System authorization prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace needs administrator access to modify the selected Homebrew or application files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace 需要管理员权限才能修改所选的 Homebrew 或应用程序文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace necesita acceso de administrador para modificar los archivos seleccionados de Homebrew o de aplicaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したHomebrewまたはアプリケーションのファイルを変更するには、Pomaceに管理者権限が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 Homebrew 또는 응용 프로그램 파일을 수정하려면 Pomace에 관리자 접근 권한이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace benötigt Administratorzugriff, um die ausgewählten Homebrew- oder Programmdateien zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace a besoin d’un accès administrateur pour modifier les fichiers sélectionnés de Homebrew ou des applications."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pomace precisa de acesso de administrador para modificar os arquivos selecionados do Homebrew ou de aplicativos."
          }
        }
      }
    },
    "core.compressionMode.automatic": {
      "comment": "Mode explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace measures this folder and picks what works best for it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
