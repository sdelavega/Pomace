    "core.compressionMode.fastest": {
      "comment": "Mode explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishes soonest, reclaiming a little less"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最快完成，但释放的空间略少"
