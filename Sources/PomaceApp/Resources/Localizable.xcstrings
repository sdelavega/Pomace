    "core.safetyReason.adobeApplication": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe application — excluded because its installation components perform integrity checks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe 应用程序：安装组件会执行完整性检查，因此已排除"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicación de Adobe: excluida porque sus componentes de instalación realizan comprobaciones de integridad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobeアプリケーション。インストール関連のコンポーネントが整合性を確認するため、除外します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe 응용 프로그램 — 설치 구성 요소가 무결성 검사를 수행하므로 제외됨"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe-Programm: ausgeschlossen, da Installationskomponenten Integritätsprüfungen durchführen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application Adobe — exclue, car ses composants d’installation effectuent des contrôles d’intégrité"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativo da Adobe — excluído porque seus componentes de instalação verificam a integridade"
          }
        }
      }
    },
    "core.safetyReason.appStoreApplication": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store application — leave the store-managed bundle unchanged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store 应用程序：保持由商店管理的应用程序包不变"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicación del Mac App Store: se deja intacto el paquete gestionado por la tienda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Storeのアプリケーション。ストアが管理するバンドルは変更しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store 응용 프로그램 — 스토어에서 관리하는 번들은 변경하지 않음"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programm aus dem Mac App Store: das vom Store verwaltete Paket bleibt unverändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application du Mac App Store — le paquet géré par le Store reste inchangé"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicativo da Mac App Store — o pacote gerenciado pela loja permanece intacto"
          }
        }
      }
    },
    "core.safetyReason.applicationBundle": {
      "comment": "Safety advisory",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application bundle — generally safe, and signatures still validate, but worth verifying the app afterwards"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序包：通常可安全压缩，签名仍然有效，但建议之后检查应用程序是否正常"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquete de aplicación: suele ser seguro y las firmas siguen siendo válidas, pero conviene comprobar la aplicación después"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションバンドル。通常は安全で署名も有効なままですが、圧縮後にアプリの動作を確認することをお勧めします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램 번들 — 일반적으로 안전하고 서명도 유효하지만 작업 후 앱이 정상 작동하는지 확인하는 것이 좋습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmpaket: in der Regel sicher, Signaturen bleiben gültig. Prüfen Sie danach dennoch die Funktion des Programms"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquet d’application — généralement sans risque et les signatures restent valides, mais il est conseillé de vérifier l’application ensuite"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacote de aplicativo — geralmente é seguro e as assinaturas continuam válidas, mas convém verificar o app depois"
          }
        }
      }
    },
    "core.safetyReason.cloudSyncedDirectory": {
      "comment": "Cloud service",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside %@ — modifying every file could trigger a full re-upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 中：修改每个文件可能触发全部重新上传"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de %@: modificar todos los archivos podría provocar que se vuelvan a subir por completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@内にあります。すべてのファイルを変更すると、全体が再アップロードされる可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 내부 — 모든 파일을 수정하면 전체 파일이 다시 업로드될 수 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@: das Ändern aller Dateien könnte einen vollständigen erneuten Upload auslösen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %@ — modifier tous les fichiers pourrait déclencher leur téléversement intégral"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de %@ — modificar todos os arquivos pode fazer com que sejam enviados novamente por completo"
          }
        }
      }
    },
    "core.safetyReason.existingResourceFork": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already has a resource fork, which is where the compressed data would need to go"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有资源分支，而压缩数据需要存储在该位置"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tiene una bifurcación de recursos, que es donde se guardarían los datos comprimidos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮データの保存先となるリソースフォークが、すでに使用されています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 데이터를 저장해야 할 리소스 포크가 이미 사용 중입니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besitzt bereits einen Ressourcen-Zweig, in dem die komprimierten Daten gespeichert werden müssten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Possède déjà une branche de ressources, qui serait nécessaire au stockage des données compressées"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já possui uma bifurcação de recursos, onde os dados comprimidos precisariam ser armazenados"
          }
        }
      }
    },
    "core.safetyReason.hardLinked": {
      "comment": "Legacy printf key; count of other paths sharing data, with locale plural forms. Compression affects every link. Active UI uses hardLinkedCount. Preserve the %ld integer width.",
      "extractionState": "manual",
      "localizations": {
        "en": {"variations": {"plural": {
          "one": {"stringUnit": {"state": "translated", "value": "Shares its data with %ld other file; compressing affects all of them"}},
          "other": {"stringUnit": {"state": "translated", "value": "Shares its data with %ld other files; compressing affects all of them"}}
        }}},
        "zh-Hans": {"variations": {"plural": {
          "other": {"stringUnit": {"state": "translated", "value": "与其他 %ld 个文件共享数据；压缩会影响所有这些文件"}}
        }}},
        "es": {"variations": {"plural": {
          "one": {"stringUnit": {"state": "translated", "value": "Comparte datos con %ld archivo más; la compresión afectaría a todos"}},
          "many": {"stringUnit": {"state": "translated", "value": "Comparte datos con %ld archivos más; la compresión afectaría a todos"}},
          "other": {"stringUnit": {"state": "translated", "value": "Comparte datos con %ld archivos más; la compresión afectaría a todos"}}
        }}},
        "ja": {"variations": {"plural": {
          "other": {"stringUnit": {"state": "translated", "value": "ほかの%ld個のファイルとデータを共有しています。圧縮はすべてに影響します"}}
        }}},
        "ko": {"variations": {"plural": {
          "other": {"stringUnit": {"state": "translated", "value": "다른 파일 %ld개와 데이터를 공유하며, 압축하면 모두 영향을 받습니다"}}
        }}},
        "de": {"variations": {"plural": {
          "one": {"stringUnit": {"state": "translated", "value": "Teilt Daten mit %ld weiteren Datei; Komprimieren betrifft alle"}},
          "other": {"stringUnit": {"state": "translated", "value": "Teilt Daten mit %ld weiteren Dateien; Komprimieren betrifft alle"}}
        }}},
        "fr": {"variations": {"plural": {
          "one": {"stringUnit": {"state": "translated", "value": "Partage ses données avec %ld autre fichier ; la compression les affecterait tous"}},
          "many": {"stringUnit": {"state": "translated", "value": "Partage ses données avec %ld autres fichiers ; la compression les affecterait tous"}},
          "other": {"stringUnit": {"state": "translated", "value": "Partage ses données avec %ld autres fichiers ; la compression les affecterait tous"}}
        }}},
        "pt-BR": {"variations": {"plural": {
          "one": {"stringUnit": {"state": "translated", "value": "Compartilha dados com %ld outro arquivo; a compressão afeta todos"}},
          "many": {"stringUnit": {"state": "translated", "value": "Compartilha dados com %ld outros arquivos; a compressão afeta todos"}},
          "other": {"stringUnit": {"state": "translated", "value": "Compartilha dados com %ld outros arquivos; a compressão afeta todos"}}
        }}}
      }
    },
    "core.safetyReason.hardLinkedOne": {
      "comment": "One other hard link",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares its data with 1 other file; compressing affects all of them"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与另一个文件共享数据；压缩会影响两者"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte datos con otro archivo; la compresión afectaría a ambos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの1個のファイルとデータを共有しています。圧縮は両方に影響します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 파일 1개와 데이터를 공유하며, 압축하면 둘 다 영향을 받습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt Daten mit einer weiteren Datei; Komprimieren betrifft beide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage ses données avec un autre fichier ; la compression les affecterait tous les deux"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha dados com outro arquivo; a compressão afeta ambos"
          }
        }
      }
    },
    "core.safetyReason.likelyIncompressible": {
      "comment": "File format",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already compressed; there's little or nothing to reclaim"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经压缩过，几乎无法再释放空间"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está comprimido; se recuperaría poco o ningún espacio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでに圧縮されているため、容量はほとんど節約できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 압축된 형식(%@)이므로 확보할 공간이 거의 없습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits komprimiert; es lässt sich kaum Platz einsparen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà compressé ; le gain d’espace serait faible ou nul"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está comprimido; há pouco ou nenhum espaço a recuperar"
          }
        }
      }
    },
    "core.safetyReason.liveDatabase": {
      "comment": "Database kind",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is written to constantly; compression would be undone immediately"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会持续写入，压缩效果会立即失效"
