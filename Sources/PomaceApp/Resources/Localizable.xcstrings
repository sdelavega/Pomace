    "core.skipRemedy.fileMissing": {
      "comment": "Missing file remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was moved or deleted while Pomace was working. Nothing was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace 处理期间，此文件已被移动或删除。未更改任何内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se ha movido o eliminado mientras Pomace trabajaba. No se ha modificado nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaceの処理中にファイルが移動または削除されました。何も変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace가 작업하는 동안 파일이 이동되거나 삭제되었습니다. 아무것도 변경하지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde während der Verarbeitung verschoben oder gelöscht. Es wurde nichts geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été déplacé ou supprimé pendant le traitement. Rien n’a été modifié."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi movido ou apagado durante o processamento. Nada foi alterado."
          }
        }
      }
    },
    "core.skipRemedy.hardLinked": {
