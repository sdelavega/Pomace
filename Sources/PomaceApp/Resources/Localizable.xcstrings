    "inspector.scheduled_sweeps": {"comment":"Accessibility label for actual background service registration status.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Scheduled sweeps"}}}},
    "inspector.open_login_items": {"comment":"Inspector action opening system settings to approve the background helper.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Login Items…"}}}},
    "inspector.background_service": {"comment":"Inspector toggle registering or unregistering the recurring background helper.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Background sweep service"}}}},
    "inspector.sweeping": {"comment":"Inspector action label while an immediate sweep is running.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Sweeping…"}}}},
