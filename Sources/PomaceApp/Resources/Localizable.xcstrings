    "core.skipRemedy.insufficientSaving": {
      "comment": "Savings threshold remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left as it was — compressing it would have saved little or nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已保持原样，压缩几乎无法释放空间。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha dejado sin modificar: la compresión ahorraría poco o ningún espacio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮してもほとんど容量を節約できないため、変更しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축해도 확보할 공간이 거의 없어 파일을 그대로 두었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverändert belassen: Komprimieren hätte kaum Platz gespart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier conservé en l’état : le gain d’espace aurait été faible ou nul."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido como estava: a compressão economizaria pouco ou nenhum espaço."
          }
        }
      }
    },
