      }
    },
    "core.planWarning.zlibSlowerReads": {
      "comment": "Maximum savings tradeoff",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB reclaims marginally more space than the default, but every later read of these files is slower. Measured on a mixed corpus the difference in size was under one percent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB 比默认方式略微节省空间，但之后每次读取文件都会更慢。在混合文件集的测试中，大小差异不到 1%。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB recupera algo más de espacio que la opción predeterminada, pero todas las lecturas posteriores son más lentas. En una prueba con archivos variados, la diferencia de tamaño fue inferior al uno por ciento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIBは標準設定よりわずかに容量を節約できますが、その後のファイルの読み出しは毎回遅くなります。さまざまなファイルでの測定では、サイズの差は1%未満でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB은 기본 방식보다 공간을 조금 더 확보하지만 이후 파일을 읽을 때마다 속도가 느려집니다. 다양한 파일을 대상으로 측정한 크기 차이는 1% 미만이었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB spart geringfügig mehr Platz als die Standardeinstellung, aber jeder spätere Lesezugriff ist langsamer. Bei einer Messung mit gemischten Dateien lag der Größenunterschied unter einem Prozent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZLIB récupère un peu plus d’espace que le réglage par défaut, mais chaque lecture ultérieure de ces fichiers est plus lente. Sur un ensemble varié de fichiers, l’écart de taille mesuré était inférieur à un pour cent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ZLIB recupera um pouco mais de espaço que o padrão, mas todas as leituras posteriores desses arquivos ficam mais lentas. Em uma medição com arquivos variados, a diferença de tamanho foi inferior a um por cento."
          }
        }
      }
    },
