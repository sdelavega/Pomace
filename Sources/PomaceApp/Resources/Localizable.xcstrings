    "model.folder_unavailable": {
      "comment": "Scan failure; selected directory no longer exists or cannot be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder is no longer available. It may have been moved, renamed, or its disk ejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹已不可用。它可能已被移动、重新命名，或所在磁盘已推出。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta ya no está disponible. Puede que se haya movido o renombrado, o que se haya expulsado el disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを利用できなくなりました。移動や名前の変更、ディスクの取り出しが行われた可能性があります。"
