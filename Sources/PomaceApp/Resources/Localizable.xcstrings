    "app.credits": {"comment":"About panel credits; placeholder is the compressor source link, followed by the machine translation disclosure.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"applesauce (GPL-3.0)\n%@\n\nTranslations are machine-translated — corrections welcome."}}}},
