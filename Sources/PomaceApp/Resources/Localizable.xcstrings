    "core.safetyReason.sparseFile": {
      "comment": "Allocated and logical sizes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparse file — occupies %@ of %@. Compressing it would materialize the empty space and use more disk, not less"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稀疏文件：实际占用 %@，完整大小 %@。压缩会使空洞实际占用空间，反而增加磁盘用量"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo disperso: ocupa %@ de %@. Comprimirlo ocuparía las zonas vacías y aumentaría el uso del disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパースファイル。使用量は%@、論理サイズは%@です。圧縮すると空き領域が実体化し、ディスク使用量が増えてしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희소 파일 — 사용 공간 %@, 논리적 크기 %@. 압축하면 빈 영역이 실제 공간을 차지하여 디스크 사용량이 오히려 늘어납니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparse-Datei: belegt %@ von %@. Beim Komprimieren würden die leeren Bereiche belegt und mehr Speicherplatz benötigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier creux — occupe %@ sur %@. La compression remplirait les zones vides et augmenterait l’espace occupé"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo esparso — ocupa %@ de %@. A compressão ocuparia as áreas vazias e usaria mais espaço no disco"
          }
        }
      }
    },
    "core.safetyReason.systemPath": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
