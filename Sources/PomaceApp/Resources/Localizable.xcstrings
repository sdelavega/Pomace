    "result.hard_link_help": {
      "comment": "Duplicate hard link count tooltip; explains storage is not double-counted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These paths share storage with another file, so their bytes are counted only once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些路径与其他文件共享存储空间，因此其占用的字节数只计算一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas rutas comparten almacenamiento con otro archivo, por lo que su espacio solo se cuenta una vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのパスは別のファイルとストレージを共有しているため、容量は一度だけ計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 경로는 다른 파일과 저장 공간을 공유하므로 용량은 한 번만 계산됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Pfade teilen sich den Speicher mit einer anderen Datei. Daher wird der Speicherplatz nur einmal gezählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces chemins partagent leur stockage avec un autre fichier. L’espace utilisé n’est donc compté qu’une fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes caminhos compartilham armazenamento com outro arquivo, por isso o espaço é contado apenas uma vez."
          }
        }
      }
    },
