    "core.sweepRun.skippedCount": {"comment":"Sweep history suffix; number of files skipped, appended to successful outcome.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":" · %lld skipped"}},"other":{"stringUnit":{"state":"translated","value":" · %lld skipped"}}}}}}},
