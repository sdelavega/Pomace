    "model.next_opportunity": {"comment":"Inspector next-run status before a first completed sweep establishes an interval.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Will sweep at the next opportunity"}}}},
    "model.due_now": {"comment":"Inspector next-run status when the scheduled interval has elapsed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Due now"}}}},
    "model.scanning_only": {"comment":"Advanced compressor summary; files can be inspected but not changed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compressor unavailable — scanning only"}}}},
