    "app.scan_help": {
      "comment": "Folder chooser explanation; scanning does not change files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder or application bundle to scan. Pomace only reads it — nothing is modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取要扫描的文件夹或应用程序包。Pomace 只会读取文件，不会修改任何内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una carpeta o un paquete de aplicación. Pomace solo lo leerá; no se modificará nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンするフォルダまたはアプリケーションバンドルを選択してください。Pomaceは読み取るだけで、何も変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔할 폴더 또는 응용 프로그램 번들을 선택하세요. Pomace는 읽기만 하며 아무것도 변경하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ordner oder ein Programmpaket zum Scannen. Pomace liest die Dateien nur und ändert nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier ou un paquet d’application à analyser. Pomace ne fera que le lire, sans rien modifier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta ou um pacote de aplicativo para analisar. O Pomace apenas lê os arquivos, sem modificar nada."
          }
        }
      }
    },
    "app.credits": {
      "comment": "About panel credits; placeholder is the compressor source link, followed by the machine translation disclosure and correction guide.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\nTranslations are machine-translated — corrections welcome.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\n翻译由机器生成，欢迎提出修改建议。\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\nLas traducciones se han generado automáticamente. Tus correcciones son bienvenidas.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\n翻訳は機械翻訳です。修正のご提案を歓迎します。\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\n기계 번역을 사용했습니다. 번역 수정 제안을 환영합니다.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\nDie Übersetzungen wurden maschinell erstellt. Korrekturen sind willkommen.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\nLes traductions sont générées automatiquement. Vos corrections sont les bienvenues.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce (GPL-3.0)\n%@\n\nAs traduções foram geradas automaticamente. Correções são bem-vindas.\nhttps://github.com/sdelavega/Pomace/blob/main/docs/TRANSLATING.md"
          }
