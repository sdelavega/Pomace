    "core.safetyReason.veryLargeFile": {
      "comment": "File size",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — this one file will take a while and can't be interrupted partway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：仅此文件就需要较长时间，且无法中途停止"
