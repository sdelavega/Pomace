    "inspector.noon": {"comment":"Preferred sweep hour label for the middle of the day.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"noon"}}}},
    "inspector.reclaimed": {"comment":"Trend detail; formatted disk space currently saved.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ currently reclaimed"}}}},
    "inspector.compressed": {"comment":"First trend summary; formatted coverage followed by current reclaimed-space phrase.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ compressed · %@"}}}},
    "inspector.steady": {"comment":"Trend when coverage changed less than half a point; coverage then reclaimed-space phrase.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Coverage is steady at %@ · %@"}}}},
    "inspector.rose": {"comment":"Trend with increased coverage; magnitude in percentage points then reclaimed-space phrase.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Coverage rose %@ since the first saved scan · %@"}}}},
    "inspector.fell": {"comment":"Trend with decreased coverage; magnitude in percentage points then reclaimed-space phrase.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Coverage fell %@ since the first saved scan · %@"}}}},
    "notification.open_help": {"comment":"Multi-folder failure notification body; directs the user to actionable details in the app.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Pomace to see which files were skipped and why."}}}},
    "notification.sweep_failed": {"comment":"Single-folder failure notification title; placeholder is folder name.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pomace couldn't finish sweeping %@"}}}},
    "notification.skipped": {"comment":"Single-folder failure notification body; count skipped. English retains the existing singular wording.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld file were skipped."}},"other":{"stringUnit":{"state":"translated","value":"%lld files were skipped."}}}}}}},
    "notification.folders_failed": {"comment":"Multi-folder failure notification title; count of folders with unsuccessful sweeps.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Pomace had trouble with %lld folders"}},"other":{"stringUnit":{"state":"translated","value":"Pomace had trouble with %lld folders"}}}}}}},
    "core.safetyReason.hardLinkedCount": {"comment":"File table safety reason; count of other paths sharing data. Compression would affect every link.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Shares its data with %lld other file; compressing affects all of them"}},"other":{"stringUnit":{"state":"translated","value":"Shares its data with %lld other files; compressing affects all of them"}}}}}}},
    "core.failureMessage.hardLinkedCount": {"comment":"Run failure details; count of other paths sharing data explains why the file was skipped.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Shares its data with %lld other file"}},"other":{"stringUnit":{"state":"translated","value":"Shares its data with %lld other files"}}}}}}},
    "core.sweepRun.cancelledCount": {"comment":"Sweep history cancelled outcome; completed count. English historically uses files even for one.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"Stopped after %lld files"}},"other":{"stringUnit":{"state":"translated","value":"Stopped after %lld files"}}}}}}},
