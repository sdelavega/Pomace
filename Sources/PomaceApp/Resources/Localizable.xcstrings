    "run.administrator_help": {
      "comment": "Administrator toggle tooltip; explains protected file access and who authenticates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorize compression or decompression of protected Homebrew and application files. macOS handles authentication."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权压缩或解压缩受保护的 Homebrew 和应用程序文件。身份验证由 macOS 处理。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza la compresión o descompresión de archivos protegidos de Homebrew y de aplicaciones. macOS se encarga de la autenticación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたHomebrewやアプリケーションのファイルの圧縮・展開を許可します。認証はmacOSが行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 Homebrew 및 응용 프로그램 파일의 압축 또는 압축 해제를 허용합니다. 인증은 macOS가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt das Komprimieren oder Dekomprimieren geschützter Homebrew- und Programmdateien. Die Authentifizierung übernimmt macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise la compression ou la décompression des fichiers protégés de Homebrew et des applications. macOS gère l’authentification."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriza a compressão ou descompressão de arquivos protegidos do Homebrew e de aplicativos. O macOS cuida da autenticação."
          }
        }
      }
    },
