    "inspector.baseline": {"comment":"Empty trend chart explanation; first scan supplies the comparison point.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The first scan will establish this folder's baseline."}}}},
    "inspector.coverage_label": {"comment":"Trend accessibility label; historical fraction of files compressed.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Compression coverage over time"}}}},
