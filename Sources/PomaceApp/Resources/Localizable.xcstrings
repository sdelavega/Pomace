    "model.administrator_confirmation": {
      "comment": "Elevated confirmation; action, scanned file count, root path, exact executable path, optional custom-executable warning.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld scanned file in %3$@?\n\nThe compressor at %4$@ will run as administrator. macOS will ask for authorization; Pomace does not store your password. Safety exclusions still apply.%5$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld scanned files in %3$@?\n\nThe compressor at %4$@ will run as administrator. macOS will ask for authorization; Pomace does not store your password. Safety exclusions still apply.%5$@"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@：要处理 %3$@ 中已扫描的 %2$lld 个文件吗？\n\n位于 %4$@ 的压缩工具将以管理员身份运行。macOS 会请求授权；Pomace 不会存储你的密码。安全排除规则仍然有效。%5$@"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿%1$@ %2$lld archivo analizado en %3$@?\n\nEl compresor de %4$@ se ejecutará como administrador. macOS solicitará autorización; Pomace no guarda tu contraseña. Se seguirán aplicando las exclusiones de seguridad.%5$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿%1$@ %2$lld archivos analizados en %3$@?\n\nEl compresor de %4$@ se ejecutará como administrador. macOS solicitará autorización; Pomace no guarda tu contraseña. Se seguirán aplicando las exclusiones de seguridad.%5$@"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿%1$@ %2$lld archivos analizados en %3$@?\n\nEl compresor de %4$@ se ejecutará como administrador. macOS solicitará autorización; Pomace no guarda tu contraseña. Se seguirán aplicando las exclusiones de seguridad.%5$@"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@：%3$@内のスキャン済みファイル%2$lld個に対して実行しますか？\n\n%4$@にある圧縮ツールを管理者として実行します。macOSが認証を求めます。Pomaceはパスワードを保存しません。安全のための除外ルールは引き続き適用されます。%5$@"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@: %3$@에서 스캔한 파일 %2$lld개에 실행할까요?\n\n%4$@의 압축 도구가 관리자 권한으로 실행됩니다. macOS가 승인을 요청하며 Pomace는 암호를 저장하지 않습니다. 안전을 위한 제외 규칙은 계속 적용됩니다.%5$@"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@: %2$lld gescannte Datei in %3$@ bearbeiten?\n\nDer Kompressor unter %4$@ wird als Administrator ausgeführt. macOS fragt nach Ihrer Erlaubnis. Pomace speichert Ihr Passwort nicht. Sicherheitsbedingte Ausschlüsse gelten weiterhin.%5$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@: %2$lld gescannte Dateien in %3$@ bearbeiten?\n\nDer Kompressor unter %4$@ wird als Administrator ausgeführt. macOS fragt nach Ihrer Erlaubnis. Pomace speichert Ihr Passwort nicht. Sicherheitsbedingte Ausschlüsse gelten weiterhin.%5$@"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld fichier analysé dans %3$@ ?\n\nLe compresseur situé dans %4$@ sera exécuté en tant qu’administrateur. macOS demandera une autorisation ; Pomace ne conserve pas votre mot de passe. Les exclusions de sécurité resteront appliquées.%5$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld fichiers analysés dans %3$@ ?\n\nLe compresseur situé dans %4$@ sera exécuté en tant qu’administrateur. macOS demandera une autorisation ; Pomace ne conserve pas votre mot de passe. Les exclusions de sécurité resteront appliquées.%5$@"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld fichiers analysés dans %3$@ ?\n\nLe compresseur situé dans %4$@ sera exécuté en tant qu’administrateur. macOS demandera une autorisation ; Pomace ne conserve pas votre mot de passe. Les exclusions de sécurité resteront appliquées.%5$@"
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld arquivo analisado em %3$@?\n\nO compressor em %4$@ será executado como administrador. O macOS solicitará autorização; o Pomace não armazena sua senha. As exclusões de segurança continuarão sendo aplicadas.%5$@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld arquivos analisados em %3$@?\n\nO compressor em %4$@ será executado como administrador. O macOS solicitará autorização; o Pomace não armazena sua senha. As exclusões de segurança continuarão sendo aplicadas.%5$@"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ %2$lld arquivos analisados em %3$@?\n\nO compressor em %4$@ será executado como administrador. O macOS solicitará autorização; o Pomace não armazena sua senha. As exclusões de segurança continuarão sendo aplicadas.%5$@"
                }
              }
            }
          }
        }
      }
    },
