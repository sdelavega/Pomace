        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se modifica constantemente; la compresión se desharía de inmediato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には常に書き込みが行われるため、圧縮してもすぐに元に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 지속적으로 쓰기가 이루어져 압축이 즉시 풀리게 됩니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird ständig beschrieben; die Komprimierung würde sofort wieder aufgehoben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est modifié en permanence ; la compression serait immédiatement annulée"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recebe gravações constantes; a compressão seria desfeita imediatamente"
          }
        }
      }
    },
    "core.safetyReason.networkVolume": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network volumes don't support transparent compression"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络宗卷不支持透明压缩"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los volúmenes de red no admiten compresión transparente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークボリュームは透過的な圧縮に対応していません"
          }
        },
        "ko": {
          "stringUnit": {
