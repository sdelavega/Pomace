    "core.serviceStatus.notFound": {
      "comment": "Service status",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace can't register its background helper. Move Pomace to your Applications folder and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace 无法注册后台辅助程序。请将 Pomace 移到“应用程序”文件夹后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomace no puede registrar su proceso auxiliar en segundo plano. Mueve Pomace a la carpeta Aplicaciones y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomaceのバックグラウンドヘルパーを登録できません。Pomaceを「アプリケーション」フォルダに移動して、やり直してください。"
