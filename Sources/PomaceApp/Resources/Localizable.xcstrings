    "content.decompress_explanation": {
      "comment": "Decompression confirmation; explains disk growth and reassures that contents stay intact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This returns those files to their full size on disk. Their contents are unchanged, and you can compress them again at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件在磁盘上占用的空间将恢复到完整大小。文件内容不会改变，你随时可以再次压缩。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos volverán a ocupar su tamaño completo en el disco. Su contenido no cambiará y podrás comprimirlos de nuevo cuando quieras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがディスク上で元のサイズに戻ります。内容は変わりません。いつでも再び圧縮できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 디스크에서 원래 크기로 복원됩니다. 내용은 바뀌지 않으며 언제든지 다시 압축할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien belegen danach wieder ihre volle Größe auf dem Datenträger. Ihr Inhalt bleibt unverändert, und Sie können sie jederzeit erneut komprimieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers retrouveront leur taille complète sur le disque. Leur contenu restera intact et vous pourrez les compresser à nouveau à tout moment."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos voltarão a ocupar o tamanho completo no disco. O conteúdo permanecerá intacto, e você poderá comprimi-los novamente a qualquer momento."
          }
        }
      }
    },
