    "accessibility.coverage_saved": {
      "comment": "Coverage bar spoken value; formatted percent of compressed files, then formatted disk space saved.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%@ compressed, %@ saved" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已压缩 %@，节省 %@ 空间" } },
        "es": { "stringUnit": { "state": "translated", "value": "%@ comprimido, %@ de espacio recuperado" } },
        "ja": { "stringUnit": { "state": "translated", "value": "%@を圧縮済み、%@を節約" } },
        "ko": { "stringUnit": { "state": "translated", "value": "%@ 압축됨, 공간 %@ 확보" } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ komprimiert, %@ Speicherplatz eingespart" } },
        "fr": { "stringUnit": { "state": "translated", "value": "%@ compressés, %@ d’espace récupéré" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "%@ comprimido, %@ de espaço recuperado" } }
      }
    },
    "accessibility.detail": {
      "comment": "VoiceOver item: state name followed by its full reason or compression type; also timeline date followed by space saved.",
