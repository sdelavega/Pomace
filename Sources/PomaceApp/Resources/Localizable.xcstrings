    "model.custom": {"comment":"Compressor summary source; executable selected by the user.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Custom"}}}},
    "model.custom_administrator_warning": {"comment":"Elevated confirmation suffix; warns that the user-selected executable receives administrator privileges.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"\n\nCustom compressor: This is a compressor you chose, not the one bundled with Pomace. It will run with administrator privileges."}}}},
    "model.folder_changed": {"comment":"Run refusal after folder selection changed during administrator confirmation.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected folder changed. Start the operation again."}}}},
    "model.nothing_compressed": {"comment":"Decompression refusal when there are no compressed target files.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nothing here is compressed."}}}},
    "model.folder_unavailable": {"comment":"Scan failure; selected directory no longer exists or cannot be reached.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"That folder is no longer available. It may have been moved, renamed, or its disk ejected."}}}},
    "model.next_sweep": {"comment":"Inspector next-run status; placeholder is a localized relative time.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Next sweep %@"}}}},
    "model.tool_summary": {"comment":"Advanced compressor summary; tool name with version, then localized source label.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ — %@"}}}},
    "model.administrator_confirmation": {"comment":"Elevated confirmation; action, scanned file count, root path, exact executable path, optional custom-executable warning.","extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%1$@ %2$lld scanned file in %3$@?\n\nThe compressor at %4$@ will run as administrator. macOS will ask for authorization; Pomace does not store your password. Safety exclusions still apply.%5$@"}},"other":{"stringUnit":{"state":"translated","value":"%1$@ %2$lld scanned files in %3$@?\n\nThe compressor at %4$@ will run as administrator. macOS will ask for authorization; Pomace does not store your password. Safety exclusions still apply.%5$@"}}}}}}},
