    "core.justificationReason.sparseWouldGrow": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "compressing one would materialise its empty space and use more disk, not less"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩会使未占用的空洞实际占用空间，反而增加磁盘用量"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "comprimirlos ocuparía el espacio vacío y aumentaría el uso del disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮すると空き領域が実体化し、ディスク使用量が増えてしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축하면 비어 있는 영역이 실제 공간을 차지하여 디스크 사용량이 오히려 늘어납니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "beim Komprimieren würden die leeren Bereiche belegt und mehr Speicherplatz benötigt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la compression remplirait les zones vides et augmenterait l’espace occupé"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a compressão ocuparia as áreas vazias e usaria mais espaço no disco"
          }
        }
      }
    },
    "core.justificationReason.speedRequested": {
