    "core.skipRemedy.resourceFork": {
      "comment": "Resource fork remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file already uses its resource fork, so it can't be compressed. It will be skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件的资源分支已被占用，无法压缩。将跳过此文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo ya usa su bifurcación de recursos y no se puede comprimir. Se omitirá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはリソースフォークを使用しているため、圧縮できません。スキップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 이미 리소스 포크를 사용하고 있어 압축할 수 없습니다. 이 파일을 건너뜁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei verwendet ihren Ressourcen-Zweig bereits und kann nicht komprimiert werden. Sie wird übersprungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier utilise déjà sa branche de ressources et ne peut pas être compressé. Il sera ignoré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo já usa sua bifurcação de recursos e não pode ser comprimido. Ele será ignorado."
          }
        }
      }
    },
    "core.skipRemedy.unchanged": {
      "comment": "Generic failure remedy",
      "extractionState": "manual",
      "localizations": {
        "en": {
