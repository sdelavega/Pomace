        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 applesauce 不支持 %@；将改用 %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de applesauce no admite %@; se usará %@ en su lugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このapplesauceは%@に対応していないため、代わりに%@を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 applesauce에서 지원하지 않는 방식: %@. 대신 사용하는 방식: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von applesauce unterstützt %@ nicht. Stattdessen wird %@ verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version d’applesauce ne prend pas en charge %@ ; %@ sera utilisé à la place."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do applesauce não oferece suporte a %@; será usado %@ no lugar."
          }
