    "core.engineError.readOnlyVolume": {
      "comment": "Read-only volume",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This volume is read-only. Administrator access cannot make it writable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此宗卷为只读。管理员权限也无法使其可写。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este volumen es de solo lectura. El acceso de administrador no permite escribir en él."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームは読み出し専用です。管理者権限でも書き込みはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨은 읽기 전용입니다. 관리자 접근 권한으로도 쓰기 가능하게 만들 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Volume ist schreibgeschützt. Auch Administratorzugriff ermöglicht keine Schreibzugriffe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce volume est en lecture seule. L’accès administrateur ne permet pas d’y écrire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este volume é somente leitura. O acesso de administrador não permite gravar nele."
          }
        }
      }
    },
    "core.engineError.safetyMetadataUnreadable": {
      "comment": "File path",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read safety metadata for %@. Allow Pomace to inspect this file before using administrator access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@ 的安全元数据。使用管理员权限前，请允许 Pomace 检查此文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer los metadatos de seguridad de %@. Permite que Pomace examine este archivo antes de usar el acceso de administrador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の安全性メタデータを読み取れません。管理者権限を使用する前に、Pomaceがこのファイルを確認できるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 안전 메타데이터를 읽을 수 없습니다. 관리자 접근 권한을 사용하기 전에 Pomace가 이 파일을 검사할 수 있도록 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsmetadaten für %@ können nicht gelesen werden. Erlauben Sie Pomace, diese Datei vor der Verwendung von Administratorzugriff zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les métadonnées de sécurité de %@. Autorisez Pomace à examiner ce fichier avant d’utiliser l’accès administrateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os metadados de segurança de %@. Permita que o Pomace examine este arquivo antes de usar o acesso de administrador."
          }
        }
      }
    },
