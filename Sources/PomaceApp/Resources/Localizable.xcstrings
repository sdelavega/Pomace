    "core.safetyReason.virtualMachineImage": {
      "comment": "Safety exclusion",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machine images are written in place and can use low-level disk access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟机映像会被原位写入，还可能使用底层磁盘访问"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de máquinas virtuales se modifican directamente y pueden usar acceso de bajo nivel al disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシンイメージは直接書き換えられ、低レベルのディスクアクセスを使用する場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 머신 이미지는 제자리에서 쓰기가 이루어지며 저수준 디스크 접근을 사용할 수 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Images virtueller Maschinen werden direkt überschrieben und können direkten Datenträgerzugriff verwenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images de machines virtuelles sont modifiées sur place et peuvent accéder au disque à bas niveau"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens de máquinas virtuais são modificadas no próprio local e podem usar acesso de baixo nível ao disco"
          }
        }
      }
    },
