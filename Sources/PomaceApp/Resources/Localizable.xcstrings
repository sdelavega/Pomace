    "model.custom_administrator_warning": {
      "comment": "Elevated confirmation suffix; warns that the user-selected executable receives administrator privileges.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCustom compressor: This is a compressor you chose, not the one bundled with Pomace. It will run with administrator privileges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n自定义压缩工具：这是你自行选取的工具，并非 Pomace 内置的工具。它将以管理员权限运行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCompresor personalizado: has elegido este compresor en lugar del incluido con Pomace. Se ejecutará con privilegios de administrador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nカスタム圧縮ツール：これはご自身で選択したツールで、Pomaceに内蔵されたものではありません。管理者権限で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n사용자 지정 압축 도구: Pomace에 내장된 도구가 아닌 직접 선택한 도구입니다. 관리자 권한으로 실행됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nBenutzerdefinierter Kompressor: Diesen Kompressor haben Sie selbst gewählt. Er wurde nicht mit Pomace geliefert und wird mit Administratorrechten ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCompresseur personnalisé : vous avez choisi ce compresseur à la place de celui inclus dans Pomace. Il sera exécuté avec les privilèges administrateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCompressor personalizado: você escolheu este compressor em vez do incluído no Pomace. Ele será executado com privilégios de administrador."
          }
        }
      }
    },
