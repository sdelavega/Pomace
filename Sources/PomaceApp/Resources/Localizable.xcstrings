    "core.justificationReason.defaultLZFSE": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "default — reads back fastest, for a ratio within a point of the alternatives"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认选择：读取最快，压缩率与其他方案相差不到一个百分点"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "opción predeterminada: lectura más rápida y una tasa de compresión a menos de un punto de las alternativas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準設定。読み出しが最も速く、圧縮率の差はほかの方式と1ポイント以内です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값: 읽기 속도가 가장 빠르며 압축률은 다른 방식과 1%포인트 이내의 차이입니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: schnellstes Lesen, Komprimierungsrate weicht höchstens um einen Prozentpunkt von den Alternativen ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "choix par défaut : lecture la plus rapide, avec un taux de compression à moins d’un point des autres méthodes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "padrão: leitura mais rápida, com taxa de compressão a menos de um ponto das alternativas"
          }
        }
      }
    },
    "core.justificationReason.hardLinksRefused": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce refuses files that share storage with another file, which is why Pomace lists them as excluded rather than silently doing nothing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce 不处理与其他文件共享存储空间的文件，因此 Pomace 会明确将其列为已排除"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce rechaza los archivos que comparten almacenamiento con otros; por eso Pomace los muestra como excluidos en lugar de no hacer nada sin avisar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauceはストレージを共有するファイルを処理しないため、Pomaceは何もせずに済ませるのではなく、除外対象として表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce는 다른 파일과 저장 공간을 공유하는 파일의 압축을 거부하므로 Pomace는 아무 작업 없이 넘어가는 대신 제외된 파일로 표시합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce lehnt Dateien mit gemeinsamem Speicher ab. Deshalb zeigt Pomace sie als ausgeschlossen an, statt sie ohne Hinweis zu übergehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce refuse les fichiers qui partagent leur stockage avec un autre fichier ; Pomace les signale donc comme exclus plutôt que de ne rien faire sans explication"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o applesauce recusa arquivos que compartilham armazenamento com outro arquivo; por isso o Pomace os mostra como excluídos em vez de ignorá-los sem aviso"
          }
        }
      }
    },
    "core.justificationReason.maximumSavingsRequested": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you asked for maximum savings — a slightly better ratio, and slower to read back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择了最大空间节省：压缩率略好，但读取会更慢"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "has elegido el máximo ahorro: una tasa algo mejor a cambio de una lectura más lenta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量優先が選択されています。圧縮率はやや高くなりますが、読み出しが遅くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간 우선을 선택했습니다. 압축률은 조금 높아지지만 읽기 속도는 느려집니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben maximale Ersparnis gewählt: etwas bessere Komprimierungsrate, langsameres Lesen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vous avez choisi le gain maximal : un taux légèrement meilleur, mais une lecture plus lente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "você escolheu a máxima economia: uma taxa um pouco melhor, mas leitura mais lenta"
          }
        }
      }
    },
