    "core.engineError.compressorChanged": {
      "comment": "Confirmed and newly resolved paths",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressor changed after you confirmed administrator access. Confirmed: %@. Resolved: %@. Start the operation again to confirm the new compressor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确认管理员权限后，压缩工具发生了变化。已确认：%@。当前解析到：%@。请重新开始操作以确认新的压缩工具。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El compresor ha cambiado después de que confirmaras el acceso de administrador. Confirmado: %@. Detectado ahora: %@. Inicia la operación de nuevo para confirmar el nuevo compresor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限でのアクセスを確認した後に、圧縮ツールが変更されました。確認時：%@。現在：%@。操作をやり直して、新しい圧縮ツールを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 접근 권한을 확인한 후 압축 도구가 변경되었습니다. 확인한 경로: %@. 현재 경로: %@. 새 압축 도구를 확인하려면 작업을 다시 시작하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kompressor hat sich nach Ihrer Bestätigung des Administratorzugriffs geändert. Bestätigt: %@. Jetzt ermittelt: %@. Starten Sie den Vorgang erneut, um den neuen Kompressor zu bestätigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compresseur a changé après votre confirmation de l’accès administrateur. Confirmé : %@. Détecté maintenant : %@. Relancez l’opération pour confirmer le nouveau compresseur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compressor mudou após a confirmação do acesso de administrador. Confirmado: %@. Detectado agora: %@. Inicie a operação novamente para confirmar o novo compressor."
          }
        }
      }
    },
    "core.engineError.compressorUnavailable": {
      "comment": "Resolution failed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressor is unavailable or lacks required verification support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩工具不可用，或不支持必需的验证功能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El compresor no está disponible o no admite la verificación obligatoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮ツールを使用できないか、必須の検証機能に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 도구를 사용할 수 없거나 필수 검증 기능을 지원하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kompressor ist nicht verfügbar oder unterstützt die erforderliche Überprüfung nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compresseur est indisponible ou ne prend pas en charge la vérification obligatoire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compressor está indisponível ou não oferece a verificação obrigatória."
          }
        }
      }
    },
    "core.engineError.insufficientFreeSpace": {
      "comment": "Available and needed space",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space to work safely — %@ available, %@ needed for the temporary replacement file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，无法安全操作：现有 %@，临时替换文件需要 %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio para trabajar con seguridad: hay %@ disponibles y se necesitan %@ para el archivo de sustitución temporal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に処理するための空き容量が不足しています。空き容量は%@ですが、一時的な置き換えファイルに%@必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 작업할 공간이 부족합니다. 사용 가능한 공간은 %@이며 임시 대체 파일에 %@가 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicherplatz für einen sicheren Vorgang: %@ verfügbar, %@ für die temporäre Ersatzdatei erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
