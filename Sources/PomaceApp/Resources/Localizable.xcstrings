    "core.justificationReason.minimumSavingThreshold": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "files that would gain less than this are left alone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节省空间低于此值的文件将保持原样"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los archivos que ahorrarían menos se dejan sin modificar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節約率がこの値に満たないファイルは変更しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절약 비율이 이 값보다 작은 파일은 변경하지 않습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien mit geringerer Ersparnis bleiben unverändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les fichiers dont le gain serait inférieur restent inchangés"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "arquivos cuja economia seria menor ficam sem alterações"
          }
        }
