    "run.stopping_help": {
      "comment": "Run progress after Stop; active work finishes safely before stopping.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the active batch to finish safely. No further batches will start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待当前批次安全完成。之后不会再启动新的批次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que el lote actual termine de forma segura. No se iniciarán más lotes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバッチが安全に完了するまで待機しています。次のバッチは開始しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 일괄 작업이 안전하게 끝나기를 기다리고 있습니다. 추가 일괄 작업은 시작하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Stapel wird noch sicher abgeschlossen. Weitere Stapel werden nicht gestartet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la fin du lot en cours pour un arrêt sûr. Aucun autre lot ne sera lancé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando a conclusão segura do lote atual. Nenhum outro lote será iniciado."
          }
        }
      }
    },
