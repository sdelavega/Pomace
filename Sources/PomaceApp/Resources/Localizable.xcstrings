    "core.justificationReason.verificationAlwaysOn": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce re-reads every file and compares it before replacing the original; Pomace never turns this off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce 会重新读取并比较每个文件，再替换原文件；Pomace 始终启用此验证"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce vuelve a leer y compara cada archivo antes de sustituir el original; Pomace nunca desactiva esta verificación"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauceは元のファイルを置き換える前に、すべてのファイルを再読み込みして比較します。Pomaceではこの検証を常に有効にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce는 원본을 대체하기 전에 모든 파일을 다시 읽고 비교합니다. Pomace는 이 검증을 항상 사용합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce liest jede Datei erneut und vergleicht sie vor dem Ersetzen des Originals. Pomace schaltet dies nie aus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce relit et compare chaque fichier avant de remplacer l’original ; Pomace ne désactive jamais cette vérification"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o applesauce relê e compara cada arquivo antes de substituir o original; o Pomace nunca desativa essa verificação"
          }
        }
      }
    },
