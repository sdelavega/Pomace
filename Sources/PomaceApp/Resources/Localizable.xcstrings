    "core.justificationReason.defaultLZFSE": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "default — reads back fastest, for a ratio within a point of the alternatives"
          }
        }
      }
    },
    "core.justificationReason.hardLinksRefused": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce refuses files that share storage with another file, which is why Pomace lists them as excluded rather than silently doing nothing"
          }
        }
      }
    },
    "core.justificationReason.maximumSavingsRequested": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you asked for maximum savings — a slightly better ratio, and slower to read back"
          }
        }
      }
    },
    "core.justificationReason.measuredBest": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "measured best on this folder"
          }
        }
      }
    },
    "core.justificationReason.minimumSavingThreshold": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "files that would gain less than this are left alone"
          }
        }
      }
    },
    "core.justificationReason.setByUser": {
      "comment": "Override reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set by you"
          }
        }
      }
    },
    "core.justificationReason.sparseWouldGrow": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "compressing one would materialise its empty space and use more disk, not less"
          }
        }
      }
    },
    "core.justificationReason.speedRequested": {
      "comment": "Policy reason fragment",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "you asked for speed"
          }
        }
      }
    },
    "core.justificationReason.verificationAlwaysOn": {
      "comment": "Fixed safety reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "applesauce re-reads every file and compares it before replacing the original; Pomace never turns this off"
          }
        }
      }
    },
    "core.justificationValue.alwaysOn": {
      "comment": "Fixed verification value",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always on"
          }
        }
      }
    },
    "core.justificationValue.percent": {
