    "inspector.history": {"comment":"Inspector heading for past sweep outcomes.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"History"}}}},
    "inspector.no_sweeps": {"comment":"Empty sweep history message.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No sweeps yet."}}}},
