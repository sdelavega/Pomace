<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Deliberately NOT sandboxed: ADR-0004. Installing afsctool, registering launchd
       agents, and scanning arbitrary user directories are each individually
       incompatible with the App Sandbox. -->
  <key>com.apple.security.app-sandbox</key><false/>
  <key>com.apple.security.cs.allow-jit</key><false/>
  <!-- Needed to invoke afsctool as a subprocess once M2 lands. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
